# OAuth client JSON (Desktop app) з Google Cloud Console
OAUTH_CLIENT=credentials/oauth_client.json

# ID папки Google Drive з вихідними аудіофайлами (туди ж вивантажуються транскрипти)
SOURCE_FOLDER_ID=

# ID вихідної таблиці-шаблону (Google Sheet) з критеріями оцінки
SOURCE_SHEET_ID=

# ID папки на Google Drive, куди вивантажується звіт «Звіт прослуханих розмов»
REPORT_FOLDER_ID=

# Gemini — транскрипція аудіо + аналіз дзвінків
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Обмеження кількості файлів за прогін (0 = без обмеження). Зручно для тесту.
MAX_FILES=0
